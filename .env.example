# Database Config
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=computer_stock
DB_PORT=3306

# Server Config
PORT=5189
HOST=0.0.0.0

# Auth (บังคับ — เซิร์ฟเวอร์จะไม่เริ่มถ้าไม่ตั้ง) ใช้รหัสผ่านยาว ๆ และใช้ผ่าน HTTPS/reverse proxy เมื่อออกนอก LAN
AUTH_USER=
AUTH_PASSWORD=
# CORS_ORIGINS=https://example.hospital.local   (คั่นด้วย , ปล่อยว่าง = ปิด CORS)

# Supabase — ใช้เฉพาะสคริปต์ใน scripts/ รันจากเครื่อง admin เท่านั้น ห้าม commit/ห้ามใส่ในหน้าเว็บ
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sync จาก Hosoffice (อ่านอย่างเดียว) — ใช้ผู้ใช้ที่มีสิทธิ์ SELECT เท่านั้น และแยกจากฐานของแอป (DB_*)
HOSOFFICE_DB_HOST=
HOSOFFICE_DB_PORT=3306
HOSOFFICE_DB_USER=
HOSOFFICE_DB_PASSWORD=
HOSOFFICE_DB_NAME=hosoffice
HOSOFFICE_INVEN_ID=2          # 2 = คลังสารสนเทศ
SYNC_FROM_DATE=2025-10-01     # เริ่มปีงบ 2569
SYNC_INTERVAL_MIN=            # เช่น 60 = sync ทุกชั่วโมง (ว่าง = sync เมื่อกดเอง)

# ปล่อยว่างไว้ — ด่านป้องกันจะไม่ให้ DB_* ชี้ฐาน/เซิร์ฟเวอร์ Hosoffice (ตั้งเป็น 1 เฉพาะเมื่อตั้งใจจริง ๆ)
ALLOW_APP_DB_ON_HOSOFFICE_SERVER=
