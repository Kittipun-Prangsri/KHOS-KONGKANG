# Database Config
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=computer_stock
DB_PORT=3306

# Server Config
PORT=5189
HOST=0.0.0.0

# CORS_ORIGINS=https://example.hospital.local   (คั่นด้วย , ปล่อยว่าง = ปิด CORS)

# Supabase — ใช้เฉพาะสคริปต์ใน scripts/ รันจากเครื่อง admin เท่านั้น ห้าม commit/ห้ามใส่ในหน้าเว็บ
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sync จาก Hosoffice (อ่านอย่างเดียว) — เซิร์ฟเวอร์เดียวกับ DB_* ได้ แต่ต้องคนละฐาน (hosoffice vs computer_stock)
HOSOFFICE_DB_HOST=
HOSOFFICE_DB_PORT=3306
HOSOFFICE_DB_USER=
HOSOFFICE_DB_PASSWORD=
HOSOFFICE_DB_NAME=hosoffice
HOSOFFICE_INVEN_ID=2          # 2 = คลังสารสนเทศ
SYNC_FROM_DATE=2025-10-01     # เริ่มปีงบ 2569
SYNC_INTERVAL_MIN=            # เช่น 60 = sync ทุกชั่วโมง (ว่าง = sync เมื่อกดเอง)


# ล็อกอินด้วยบัญชีจากตาราง hr_person ของ Hosoffice (ดู db/README.md ขอสิทธิ์ SELECT แบบระบุคอลัมน์เท่านั้น)
# ตารางจริง: hosoffice.hr_person — ใช้ HR_PASSWORD (MD5) ไม่ใช่ HR_PASSWORD_HASH (bcrypt)
# เหตุผล: HR_PASSWORD_HASH ไม่ถูกอัปเดตเมื่อผู้ใช้เปลี่ยนรหัสผ่านผ่าน Hosoffice (ยืนยันแล้วจากการทดสอบจริง)
#         ส่วน HR_PASSWORD (ตรวจแล้วว่าทุกบัญชียาว 32 ตัวอักษรเท่ากัน = MD5) จะตรงกับรหัสผ่านปัจจุบันเสมอ
HR_TABLE=hr_person
HR_ID_COL=ID
HR_USER_COL=HR_USERNAME
HR_PASS_COL=HR_PASSWORD
HR_PASS_ALGO=md5
HR_NAME_COLS=HR_FNAME,HR_LNAME
HR_ACTIVE_COL=HR_STATUS_ID
HR_ACTIVE_VALUE=01         # ค่า HR_STATUS_ID ที่แปลว่าใช้งานอยู่ (เฉพาะค่านี้เท่านั้นที่เข้าได้)

# ความปลอดภัยของ session
APP_SECRET=                # ข้อความสุ่มยาว ๆ สำหรับแฮชชื่อผู้ใช้ที่พิมพ์ตอนล็อกอิน (สร้างด้วย: openssl rand -hex 32)
SESSION_HOURS=8          # อายุ session (ชั่วโมง)
COOKIE_SECURE=           # ตั้ง 1 เมื่อเข้าผ่าน HTTPS (reverse proxy)
TRUST_PROXY=             # ตั้ง 1 เมื่ออยู่หลัง reverse proxy เพื่ออ่าน IP จริง
